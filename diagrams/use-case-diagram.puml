@startuml use-case-diagram
left to right direction

title South Kerry Community Travel Network: Use Case Diagram (First Release)

actor "Office Staff" as Staff
actor "Coordinator" as Coord
actor "Volunteer/Employed Driver" as Driver

rectangle "Transport Coordination System" {
  usecase "Record Transport Request" as UC01
  usecase "Amend Request" as UC02
  usecase "Log Driver Contact Attempt" as UC04
  usecase "Confirm Journey with Passenger" as UC05
  usecase "Cancel Journey" as UC07
  usecase "Record Driver Unavailability" as UC08
  usecase "Assign Driver and Vehicle" as UC03
  usecase "Produce Funder Report" as UC09
  usecase "Record Journey Progress" as UC06
}

Staff --> UC01
Staff --> UC02
Staff --> UC04
Staff --> UC05
Staff --> UC07
Staff --> UC08
Coord --> UC03
Coord --> UC09
Driver --> UC06

@enduml
